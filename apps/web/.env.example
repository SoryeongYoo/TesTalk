# Anthropic Claude API 키. 서버 코드(apps/web/lib/server, Server Action)에서만 읽는다.
# 절대 클라이언트 컴포넌트나 NEXT_PUBLIC_ 접두사로 노출하지 말 것.
# 발급: https://console.anthropic.com/settings/keys
#
# 사용법: 이 파일을 apps/web/.env.local 로 복사하고 실제 키를 채워 넣는다.
# .env.local은 .gitignore에 포함되어 있어 커밋되지 않는다.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# AWS Cognito 로그인 (NextAuth/Auth.js). CLIENT_SECRET은 서버 전용(auth.ts)에서만 읽힌다.
# 절대 클라이언트 컴포넌트나 NEXT_PUBLIC_ 접두사로 노출하지 말 것.
# Cognito 콘솔 > 앱 클라이언트에서 확인. 콜백 URL은
# http://localhost:3000/api/auth/callback/cognito 로 등록되어 있어야 한다.
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_ISSUER=https://cognito-idp.<region>.amazonaws.com/<region>_xxxxxxxxx

# NextAuth 세션 암호화 키. `openssl rand -base64 32` (또는 `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`) 로 생성한다.
NEXTAUTH_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXTAUTH_URL=http://localhost:3000
