# Anthropic Claude API 키. 서버 코드(apps/web/lib/server, Server Action)에서만 읽는다.
# 절대 클라이언트 컴포넌트나 NEXT_PUBLIC_ 접두사로 노출하지 말 것.
# 발급: https://console.anthropic.com/settings/keys
#
# 사용법: 이 파일을 apps/web/.env.local 로 복사하고 실제 키를 채워 넣는다.
# .env.local은 .gitignore에 포함되어 있어 커밋되지 않는다.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# AWS Cognito 로그인 (NextAuth/Auth.js). CLIENT_SECRET은 서버 전용(auth.ts)에서만 읽힌다.
# 절대 클라이언트 컴포넌트나 NEXT_PUBLIC_ 접두사로 노출하지 말 것.
# Cognito 콘솔 > 앱 클라이언트에서 확인. 콜백 URL은
# http://localhost:3000/api/auth/callback/cognito 로 등록되어 있어야 한다.
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_ISSUER=https://cognito-idp.<region>.amazonaws.com/<region>_xxxxxxxxx
# Hosted UI 도메인 (Cognito 콘솔 > 도메인). 로그아웃 시 Cognito 세션도 끊는 데 쓴다.
# 미설정이면 로그아웃이 NextAuth 세션만 지워, 다음 로그인 때 기존 계정으로 자동 로그인된다.
COGNITO_DOMAIN=<prefix>.auth.<region>.amazoncognito.com
# 로그아웃 후 복귀 URL. 앱 클라이언트의 "허용된 로그아웃 URL"에 정확히 같은 값이 등록돼 있어야 한다.
# 미설정이면 현재 요청의 origin(예: http://localhost:3000, https://testalk.click)을 쓴다.
# COGNITO_LOGOUT_URI=http://localhost:3000

# NextAuth 세션 암호화 키. `openssl rand -base64 32` (또는 `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`) 로 생성한다.
NEXTAUTH_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXTAUTH_URL=http://localhost:3000

# AWS RDS PostgreSQL 연결 문자열 (Drizzle ORM). 서버 전용 코드(apps/web/lib/server/db)에서만 읽는다.
# 절대 클라이언트 컴포넌트나 NEXT_PUBLIC_ 접두사로 노출하지 말 것.
# 형식: postgresql://user:pass@host:5432/testalk
# AWS RDS는 기본적으로 SSL 접속을 요구한다 (apps/web/lib/server/db/client.ts에서 ssl: "require" 기본 적용).
# SSL이 없는 로컬 Postgres(Docker 등)로 개발할 때만 DATABASE_SSL=disable을 추가로 설정한다.
DATABASE_URL=postgresql://user:pass@your-rds-endpoint.ap-northeast-2.rds.amazonaws.com:5432/testalk
# DATABASE_SSL=disable

# 로그인 사용자당 하루(KST 자정 리셋) 무료 시험 생성 횟수. 0 이상 정수, 미설정 시 기본 2.
# (apps/web/lib/server/generationLimit.ts) Amplify 콘솔에 설정하면 amplify.yml이 런타임으로 넘긴다.
# DAILY_FREE_GENERATIONS=2

# 토스페이먼츠 결제 키 (개발자센터 > API 키). 둘 다 있어야 토스 결제가 켜진다.
# 테스트 키(test_ck_/test_sk_) ↔ 라이브 키(live_ck_/live_sk_)는 이 값만 바꾸면 교체된다.
# ⚠️ TOSS_SECRET_KEY는 서버 전용(lib/server/payments)에서만 읽는다. NEXT_PUBLIC_ 접두사 금지.
#    클라이언트 키는 서버가 주문 생성 응답으로 내려준다(빌드 시점 노출 불필요).
# 웹훅: 개발자센터 > 웹훅에 https://<도메인>/api/payments/toss/webhook 을 PAYMENT_STATUS_CHANGED로 등록.
# TOSS_CLIENT_KEY=test_ck_xxxxxxxxxxxxxxxxxxxxxxxx
# TOSS_SECRET_KEY=test_sk_xxxxxxxxxxxxxxxxxxxxxxxx

# 실결제(토스) 연동 전 테스트용 (토스 키가 없을 때만 동작): "true"일 때만 크레딧 구매가 실과금 없이 지급된다 (기본 false).
# (apps/web/lib/server/payments/index.ts) ⚠️ 로컬 개발 전용. amplify.yml 화이트리스트에 일부러
# 넣지 않았으므로 Amplify 콘솔에 설정해도 프로덕션 런타임에는 전달되지 않는다 — 넣지 말 것.
# TESTALK_ALLOW_TEST_GRANT=true
